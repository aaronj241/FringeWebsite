---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import space from '../assets/brand/space.jpg';
import { services } from '../data/site';
import { getProjects } from '../data/projects';
import { sitePath } from '../data/site-path';

const projects = await getProjects();
---

<BaseLayout description="Fringe Design offers web design, graphic design, web and email hosting, and print and promotional products.">
  <section class="hero" aria-labelledby="hero-heading">
    <Image class="hero-image" src={space} alt="" widths={[640, 960, 1280, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="container hero-content">
      <p class="hero-label">Web & graphic design</p>
      <h1 id="hero-heading">At Fringe, we make<br /> the complex <em>simple.</em></h1>
      <p class="hero-description">We design websites, logos, and promotional products that help brands stand out.</p>
      <div class="hero-actions">
        <a class="button button-light" href={sitePath('/contact-us/')}>Start a project <span aria-hidden="true">↗</span></a>
        <a class="text-link" href="#services">Explore services <span aria-hidden="true">↓</span></a>
      </div>
    </div>
  </section>

  <section class="services-section" id="services" aria-labelledby="services-heading">
    <div class="container section services-layout">
      <div class="services-intro">
        <h2 id="services-heading">What we offer</h2>
        <p>We help brands connect with their audience online and in print through clear, distinctive design.</p>
      </div>
      <dl class="service-list">
        {services.map(({ id, title, description }) => (
          <div class="service" id={id}>
            <dt>{title}</dt>
            <dd>{description}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section container" aria-labelledby="work-heading">
    <header class="section-heading">
      <h2 id="work-heading">Highlighted Work</h2>
    </header>
    <div class="project-list">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>
</BaseLayout>
