---
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjects } from '../../data/projects';
import { projectCategories } from '../../data/site';
import { sitePath } from '../../data/site-path';

export const getStaticPaths = (async () =>
  (await getProjects()).map((project) => ({
    params: { project: project.id },
    props: { project },
  }))) satisfies GetStaticPaths;

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, cover, categories, gallery, industry, published, projectUrl } = project.data;
const serviceNames = projectCategories.filter(({ id }) => categories.includes(id));
const publishedLabel = published && new Intl.DateTimeFormat('en-CA', {
  dateStyle: 'long',
  timeZone: 'UTC',
}).format(new Date(published));
---

<BaseLayout title={title} description={description}>
  <article class="container page-section">
    <a class="text-link back-link" href={sitePath('/portfolio/')}><span aria-hidden="true">←</span> All projects</a>
    <header class="page-heading">
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <div class="case-cover">
      <Image src={cover.image} alt={cover.alt} widths={[640, 960, 1280, 1600]} sizes="(max-width: 1250px) 94vw, 1200px" loading="eager" />
    </div>
    <div class="case-layout">
      <div class="case-copy">
        <h2>About the project</h2>
        <Content />
      </div>
      <aside class="case-details" aria-label="Project details">
        <dl>
          <div>
            <dt>Services</dt>
            {serviceNames.map(({ id, title }) => <dd><a href={sitePath(`/portfolio-categories/${id}/`)}>{title}</a></dd>)}
          </div>
          {industry && <div><dt>Industry</dt><dd>{industry}</dd></div>}
          {publishedLabel && <div><dt>Published</dt><dd><time datetime={published}>{publishedLabel}</time></dd></div>}
        </dl>
        {projectUrl && <a class="text-link" href={projectUrl}>Visit site <span aria-hidden="true">↗</span></a>}
      </aside>
    </div>
    {gallery.length > 0 && (
      <section class="case-gallery" aria-labelledby="gallery-heading">
        <h2 id="gallery-heading">Project images</h2>
        <div class="gallery-grid">
          {gallery.map(({ image, alt }) => (
            <a href={image.src} class="gallery-image">
              <Image src={image} alt={alt} widths={[400, 640, 960, 1280]} sizes="(max-width: 700px) 94vw, (max-width: 1250px) 45vw, 580px" />
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</BaseLayout>
