---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description="Start a project with Fringe Design. Get in touch by phone or email." showCallToAction={false}>
  <section class="container page-section contact-layout">
    <div>
      <div class="page-heading">
        <h1>Start a project</h1>
        <p>Get in touch with us to start something great.</p>
      </div>
      <dl class="contact-details">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd><a href={site.phoneHref}>{site.phone}</a></dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>{site.location}</dd>
        </div>
      </dl>
    </div>

    <form class="contact-form" id="contact-form" hidden>
      <div class="form-field">
        <label for="contact-name">Name</label>
        <input id="contact-name" name="name" autocomplete="name" placeholder="Your name" required />
      </div>
      <div class="form-field">
        <label for="contact-email">Email address</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
      </div>
      <div class="form-field">
        <label for="contact-message">Tell us about your project</label>
        <textarea id="contact-message" name="message" rows="5" maxlength="1200"></textarea>
      </div>
      <button class="button button-accent" type="submit">Send message</button>
    </form>

    <section class="contact-success" id="contact-success" aria-labelledby="contact-success-heading" hidden>
      <span class="contact-success-icon" aria-hidden="true">✓</span>
      <div>
        <h2 id="contact-success-heading" tabindex="-1" aria-describedby="contact-success-message">Message sent</h2>
        <p id="contact-success-message">A confirmation email will be sent to you shortly.</p>
      </div>
      <button class="button button-accent" id="contact-new-request" type="button">Send another request</button>
    </section>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form');
  const success = document.querySelector<HTMLElement>('#contact-success');
  const successHeading = document.querySelector<HTMLElement>('#contact-success-heading');
  const newRequest = document.querySelector<HTMLButtonElement>('#contact-new-request');
  const nameInput = document.querySelector<HTMLInputElement>('#contact-name');

  if (form && success && successHeading && newRequest && nameInput) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      form.hidden = true;
      success.hidden = false;
      successHeading.focus();
    });

    newRequest.addEventListener('click', () => {
      form.reset();
      success.hidden = true;
      form.hidden = false;
      nameInput.focus();
    });

    form.hidden = false;
  }
</script>
