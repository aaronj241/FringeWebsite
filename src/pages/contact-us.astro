---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description="Start a project with Fringe Design. Get in touch by phone or email." showCallToAction={false}>
  <section class="container page-section contact-layout">
    <div>
      <div class="page-heading">
        <h1>Start a project</h1>
        <p>Get in touch with us to start something great.</p>
      </div>
      <dl class="contact-details">
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
        </div>
        <div>
          <dt>Phone</dt>
          <dd><a href={site.phoneHref}>{site.phone}</a></dd>
        </div>
        <div>
          <dt>Location</dt>
          <dd>{site.location}</dd>
        </div>
      </dl>
    </div>

    <form class="contact-form" data-email={site.email} hidden>
      <div class="form-field">
        <label for="contact-name">Name</label>
        <input id="contact-name" name="name" autocomplete="name" placeholder="Your name" required />
      </div>
      <div class="form-field">
        <label for="contact-email">Email address</label>
        <input id="contact-email" name="email" type="email" autocomplete="email" placeholder="you@example.com" required />
      </div>
      <div class="form-field">
        <label for="contact-message">Tell us about your project</label>
        <textarea id="contact-message" name="message" rows="5" maxlength="1200"></textarea>
      </div>
      <button class="button button-accent" type="submit" aria-describedby="contact-form-hint">Open email draft <span aria-hidden="true">↗</span></button>
      <p class="form-hint" id="contact-form-hint">Review and send the draft in your email app.</p>
    </form>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-email]');

  if (form) {
    form.addEventListener('submit', (event) => {
      event.preventDefault();

      const values = new FormData(form);
      const subject = encodeURIComponent('Fringe Design project inquiry');
      const message = String(values.get('message') ?? '').replace(/\r?\n/g, '\r\n');
      const body = encodeURIComponent(
        `Name: ${values.get('name')}\r\nEmail: ${values.get('email')}\r\n\r\n${message}`,
      );

      window.location.href = `mailto:${form.dataset.email}?subject=${subject}&body=${body}`;
    });

    form.hidden = false;
  }
</script>
