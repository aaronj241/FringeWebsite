---
import { Image } from 'astro:assets';
import logo from '../assets/brand/fringe-logo-light.png';
import { site } from '../data/site';
import { sitePath } from '../data/site-path';

interface Props {
  showCallToAction: boolean;
}

const { showCallToAction } = Astro.props;
---

{showCallToAction && (
  <section class="contact-band" aria-labelledby="contact-band-heading">
    <div class="container contact-band-inner">
      <h2 id="contact-band-heading">Let’s build something together.</h2>
      <a class="button button-light" href={sitePath('/contact-us/')}>Start a project <span aria-hidden="true">↗</span></a>
    </div>
  </section>
)}
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="brand" href={sitePath('/')} aria-label="Fringe Design home">
        <Image src={logo} alt="Fringe Design" width={106} height={47} />
      </a>
      <span>{site.location}</span>
    </div>
    <div class="footer-links" aria-label="Contact details">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.phoneHref}>{site.phone}</a>
    </div>
    <div class="footer-links" aria-label="Social links">
      {site.socials.map(({ label, href }) => <a href={href}>{label} <span aria-hidden="true">↗</span></a>)}
    </div>
  </div>
</footer>
