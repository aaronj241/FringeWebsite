---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../data/site';
import { sitePath } from '../data/site-path';
import '../styles/global.css';

interface Props {
  title?: string;
  description: string;
  showCallToAction?: boolean;
}

const { title, description, showCallToAction = true } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
---

<!doctype html>
<html lang="en-CA">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f8f4" />
    <link rel="icon" type="image/png" href={sitePath('/favicon.png')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter showCallToAction={showCallToAction} />
  </body>
</html>
